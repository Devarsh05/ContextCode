# Frontend env — copy to `.env.local` (gitignored) for local dev.

# Base URL of the FastAPI backend. Defaults to http://localhost:8000 when unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Cloudflare Turnstile site key for the public chat gate. The value below is
# Cloudflare's "always passes" TEST key — it auto-clears the challenge with no
# real verification, which is what local dev and the E2E suite use. Swap in the
# real site key (paired with TURNSTILE_SECRET_KEY on the backend) for prod.
#   Test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
