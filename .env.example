# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=contextcode
POSTGRES_PASSWORD=changeme
POSTGRES_DB=contextcode

# ── Backend connection URLs ───────────────────────────────
# asyncpg driver used by SQLAlchemy async
DATABASE_URL=postgresql+asyncpg://contextcode:changeme@localhost:5432/contextcode
# Redis is the Celery broker AND the rate-limiter storage backend.
REDIS_URL=redis://localhost:6379/0

# ── ChromaDB ──────────────────────────────────────────────
# CHROMA_HOST set → client uses HttpClient against the shared Chroma server
# (docker-compose `chroma` service). Empty → embedded PersistentClient on disk.
# Local dev uses HttpClient too, matching production.
CHROMA_HOST=localhost
CHROMA_PORT=8000
# Optional bearer token sent as an Authorization header when set.
CHROMA_TOKEN=

# ── Embeddings ────────────────────────────────────────────
# "local"  → sentence-transformers all-MiniLM-L6-v2 (384 dims), dev default.
#            Requires requirements-local.txt (torch).
# "openai" → text-embedding-3-small (1536 dims), production.
EMBEDDING_PROVIDER=local

# ── OpenAI ────────────────────────────────────────────────
# Required for LLM answer generation (gpt-4o-mini default), and for embeddings
# when EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=

# ── CORS ──────────────────────────────────────────────────
# Comma-separated allowed origins. Credentials are disabled (no auth), so this
# must be an explicit list — never "*".
CORS_ALLOW_ORIGINS=http://localhost:3000

# ── Rate limiting (per client IP) ─────────────────────────
RATE_LIMIT_INDEX=10/hour
RATE_LIMIT_CHAT=30/minute
# Defaults to REDIS_URL when unset. Tests override this to memory://.
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0

# ── Cost-control gate (API service only — NOT the Celery worker) ──
# Shared secret required on POST /repos/index and POST /chat (X-Access-Code
# header). Empty ⇒ those endpoints reject every request with 401.
ACCESS_CODE=
# Global daily ceilings (keyed by UTC date, auto-reset). Tunable on Railway
# without a redeploy.
QUOTA_INDEX_DAILY=3
QUOTA_CHAT_DAILY=50
# Per-counter TTL (~25h) so the daily key self-expires even if traffic stops.
QUOTA_TTL_SECONDS=90000
