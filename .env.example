# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=contextcode
POSTGRES_PASSWORD=changeme
POSTGRES_DB=contextcode

# ── Backend connection URLs ───────────────────────────────
# asyncpg driver used by SQLAlchemy async
DATABASE_URL=postgresql+asyncpg://contextcode:changeme@localhost:5432/contextcode
REDIS_URL=redis://localhost:6379/0

# ── OpenAI (optional) ─────────────────────────────────────
# Only needed when using the OpenAI embedder instead of the
# default local sentence-transformers model.
# OPENAI_API_KEY=sk-...
